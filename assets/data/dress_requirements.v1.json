    {
      "id": "no_3_dress_requirements",
      "dress_name": "No. 3 Dress",
      "display_name": "Service Dress",
      "subtitle": "Office / parades · Daily",
      "doctrine_status": "pdf_aligned",
      "doctrine_source": "SAF No.3 Dress specification PDF (Army, Navy, RSAF, DIS)",
      "mandatory_rules": [
        {
          "category": "Headdress",
          "selection_logic": "Per-branch + per-rank-tier mapping; Sikh personnel override per-branch",
          "resolution": "see branch_overrides[branchId].headdress (men.default / men.sikh / men.sikh_<tier_above> / ladies.<tier> / unisex for DIS)"
        },
        {
          "category": "Cap_Badge",
          "selection_logic": "Per-branch + per-rank-tier",
          "resolution": "see branch_overrides[branchId].cap_badge",
          "notes": [
            "All standard cap badges carry a cadet_white_backing_diameter_mm: 53 rule for Officer Cadets.",
            "RSAF BG/ME8 and above has separate beret vs service-hat embroidered variants."
          ]
        },
        {
          "category": "Identification",
          "required_for_all": [
            "name_tag_standard"
          ],
          "branch_specific": "DIS may use dis_protocol_name_tag in protocol contexts (see branch_overrides[dis].name_tag_protocol)."
        },
        {
          "category": "Rank_Insignia",
          "logic": "Rank-group specific mapping; sleeve insignia art ID resolved per branch",
          "mapping": [
            {
              "condition": "rank_group == 'Officer_ME'",
              "required": [
                "collar_rank_pins",
                "epaulettes_standard"
              ]
            },
            {
              "condition": "rank_group == 'Warrant_Officer'",
              "required": [
                "collar_rank_pins",
                "epaulettes_standard"
              ]
            },
            {
              "condition": "rank_group == 'Specialist'",
              "required": [
                "sleeve_rank_specialist_per_branch",
                "epaulettes_standard"
              ]
            },
            {
              "condition": "rank_group == 'Enlistee_Rating'",
              "required": [
                "sleeve_rank_enlistee_per_branch"
              ]
            },
            {
              "condition": "rank_group == 'Officer_Cadet'",
              "required": [
                "epaulettes_officer_cadet_me_trainee",
                "gorgette_lady_officer_cadet (ladies only)"
              ]
            },
            {
              "condition": "rank_group == 'ME_Trainee'",
              "required": [
                "epaulettes_officer_cadet_me_trainee",
                "gorgette_lady_me_trainee (ladies only)"
              ]
            }
          ],
          "resolution_per_branch": "sleeve_rank_specialist_per_branch and sleeve_rank_enlistee_per_branch are resolved via branch_overrides[branchId].rank_insignia_sleeve.specialist / enlistee. DIS substitutes dis_epaulettes_standard / dis_epaulettes_me_trainee for the standard epaulettes in this rule (see branch_overrides[dis].epaulettes)."
        },
        {
          "category": "Belt",
          "logic": "Gender-specific belt",
          "mapping": [
            {
              "condition": "gender == 'Men'",
              "required": [
                "nylon_belt"
              ]
            },
            {
              "condition": "gender == 'Ladies'",
              "required": [
                "leather_belt"
              ]
            }
          ]
        },
        {
          "category": "Socks",
          "required_for_all": [
            "black_socks"
          ]
        },
        {
          "category": "Footwear",
          "logic": "Gender-specific footwear",
          "mapping": [
            {
              "condition": "gender == 'Men'",
              "required": [
                "leather_shoes_low_cut"
              ]
            },
            {
              "condition": "gender == 'Ladies'",
              "required": [
                "court_shoes"
              ]
            }
          ],
          "patent_variant": "Officers and formal contexts may substitute patent_shoes_low_cut (men) or patent_court_shoes (ladies)."
        }
      ],
      "optional_logic": {
        "vocation": [
          "arms_badge_or_vocation_per_branch (resolved via branch_overrides[branchId].arms_badge / vocation_badge)",
          "lanyard_per_branch (resolved via branch_overrides[branchId].lanyard)"
        ],
        "skills": [
          "saf_badges_chest",
          "skill_tabs_sleeve",
          "skill_badges_sleeve"
        ],
        "awards": [
          "medal_ribbons",
          "foreign_badges"
        ]
      },
