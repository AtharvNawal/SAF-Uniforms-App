    {
      "id": "no_4_dress_requirements",
      "dress_name": "No. 4 Dress",
      "display_name": "Smart No. 4",
      "subtitle": "Working · Pixelised",
      "doctrine_status": "pdf_aligned",
      "doctrine_source": "SAF No.4 Dress specification PDF (Army, Navy, RSAF, DIS)",
      "mandatory_rules": [
        {
          "category": "Headdress",
          "selection_logic": "Beret for all personnel (men and ladies); Sikh personnel wear a turban of the branch colour with cap badge.",
          "resolution": "see branch_overrides[branchId].headdress (unisex / sikh / sikh_col_me7_above); jockey cap / jungle hat / helmet / green field turban listed under alternatives (optional)."
        },
        {
          "category": "Cap_Badge",
          "selection_logic": "Per-branch + per-rank-tier; same badges as No. 3.",
          "resolution": "see branch_overrides[branchId].cap_badge",
          "notes": [
            "Officer Cadets have a white round backing (53 mm) behind the cap badge.",
            "COL/ME7 and BG and above wear the respective embroidered cap badge."
          ]
        },
        {
          "category": "Identification",
          "required_for_all": [
            "name_tag_standard",
            "singapore_tag"
          ]
        },
        {
          "category": "Rank_Insignia",
          "logic": "Single chest-centre rank epaulette for every rank; white cadet/trainee variant for Officer Cadets, Specialist Cadets and ME Trainees. No sleeve insignia or collar pins.",
          "resolution": "see branch_overrides[branchId].rank_epaulette (standard / cadet_trainee)"
        },
        {
          "category": "Inner_Shirt",
          "logic": "Navy grey, RSAF blue, DIS grey inner T-shirt (Army: not specified in the PDF).",
          "resolution": "see branch_overrides[branchId].additional_mandatory"
        },
        {
          "category": "Belt",
          "logic": "Army olive-green webbing belt; Navy / RSAF / DIS black webbing belt."
        },
        {
          "category": "Socks",
          "logic": "Black socks for all branches; Army may alternatively wear green socks (optional)."
        },
        {
          "category": "Footwear",
          "logic": "Army combat boots; Navy mid-cut safety boots; RSAF and DIS safety boots. Doctrine alternatives (Navy low-cut safety shoes / combat boots; RSAF and DIS combat boots) are optional."
        }
      ],
      "optional_logic": {
        "vocation": [
          "arms_badge / vocation_badge per branch (Army arms badge, RSAF collar vocation badge, DIS arms + vocation badges)"
        ],
        "skills": [
          "saf_badges_chest (max 3, left chest)",
          "skill_tabs_sleeve (max 2, left sleeve)",
          "skill_badges_sleeve (max 2, left sleeve)"
        ],
        "awards": [
          "foreign_badges (right side)"
        ],
        "headdress_alternatives": [
          "jockey cap",
          "jungle hat",
          "Kevlar helmet (Navy)",
          "ball cap (RSAF)",
          "green field turban (Sikh, Army/Navy)"
        ]
      },
      "branch_overrides": {
        "army": {
          "headdress": {
            "unisex": "army_beret",
            "sikh": "army_sikh_turban_standard",
            "sikh_col_me7_above": "army_sikh_turban_col_me7_above",
            "alternatives": [
              "army_jockey_cap",
              "army_jungle_hat"
            ],
            "sikh_alternatives": [
              "sikh_field_turban_green"
            ]
          },
          "cap_badge": {
            "sltc_me6_below": "army_cap_badge_sltc_me6_below",
            "col_me7": "army_cap_badge_col_me7",
            "bg_me8_above": "army_cap_badge_bg_me8_above"
