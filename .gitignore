# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
.vscode/

# Python venv used by tool/* operator scripts (trimesh, google-cloud, etc).
.venv-tools/
__pycache__/

# Firebase service-account JSONs (operator-only; see tool/seed_firestore.dart).
# Anything under secrets/ stays out of the repo.
secrets/

# Raw artist / Tripo / Meshy GLB exports kept locally as the source for
# tool/inject_sockets.py — large binary blobs that we don't want in git.
# Compliant outputs land in assets/3d/bodies/ and are uploaded to Storage.
assets/3d_raw/

# Flutter/Dart/Pub-related
**/doc/api/
**/ios/Flutter/ephemeral/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/

# iOS (CocoaPods, user-specific Xcode state)
ios/Pods/
ios/.symlinks/
**/xcuserdata/
*.xcworkspace/xcshareddata/

# Android (machine-local SDK paths)
android/local.properties

# Angular admin portal — build artefacts and dependency caches.
# Source files (admin-portal/src/, angular.json, package.json, etc.)
# are tracked normally.
admin-portal/node_modules/
admin-portal/dist/
admin-portal/.angular/
admin-portal/.env.local

# cv-service — model checkpoints and rendered synthetic-data batches are
# large, generated, and versioned separately (Git LFS / Cloud Storage).
# Source files (cv-service/utils, rules, api, etc.) are tracked normally.
cv-service/models/
cv-service/synthetic_data/

# cv-service — real (or stand-in) intake photos and the ground-truth
# labels produced from them. These will eventually contain photos of real
# servicemembers, so unlike the two entries above this is a privacy
# boundary, not just a size one — never commit anything under here.
# cv-service/data/schemas/ (the label schema itself) has no PII and stays
# tracked normally.
cv-service/data/real_photos/
cv-service/data/labels/

# Claude Code local (machine-specific permission grants)
.claude/settings.local.json

# Local distributable builds (unsigned .ipa, etc.)
dist/

cv-service/logs/
/yolov8s-seg.pt
