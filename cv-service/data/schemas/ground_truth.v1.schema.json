{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cv-service/data/schemas/ground_truth.v1.schema.json",
  "title": "cv-service real-photo ground-truth label",
  "description": "One label file per photo. Generated by cv-service/labeling/schema.py from utils.extract_anchors.SOCKET_NAMES and training.generate_segmentation_dataset.CLASSES \u2014 do not hand-edit; regenerate instead if those lists change.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "photo_id",
    "source_path",
    "subject_id",
    "angle",
    "lighting",
    "image_width",
    "image_height",
    "is_synthetic_stand_in",
    "annotator",
    "labeled_at",
    "anchors",
    "accessories"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "photo_id": {
      "type": "string",
      "minLength": 1
    },
    "source_path": {
      "type": "string",
      "minLength": 1
    },
    "subject_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "angle": {
      "enum": [
        "front",
        "back",
        "left_3q",
        "right_3q"
      ]
    },
    "lighting": {
      "enum": [
        "indoor_bright",
        "indoor_dim",
        "outdoor_overcast",
        "outdoor_sunny"
      ]
    },
    "image_width": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "image_height": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "is_synthetic_stand_in": {
      "type": "boolean",
      "description": "Required, not optional: true for a rendered/placeholder stand-in, false only for an actual photograph of a real person. Never inferred from the filename alone."
    },
    "annotator": {
      "type": "string",
      "minLength": 1
    },
    "labeled_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    },
    "anchors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head_top",
        "cap_band_front",
        "left_collar_tip",
        "right_collar_tip",
        "left_chest_pocket",
        "right_chest_pocket",
        "left_shoulder_seam",
        "right_shoulder_seam",
        "left_sleeve_upper",
        "right_sleeve_upper",
        "belt_center",
        "left_ankle",
        "right_ankle",
        "left_foot_top",
        "right_foot_top"
      ],
      "properties": {
        "head_top": {
          "$ref": "#/$defs/anchor_point"
        },
        "cap_band_front": {
          "$ref": "#/$defs/anchor_point"
        },
        "left_collar_tip": {
          "$ref": "#/$defs/anchor_point"
        },
        "right_collar_tip": {
          "$ref": "#/$defs/anchor_point"
        },
        "left_chest_pocket": {
          "$ref": "#/$defs/anchor_point"
        },
        "right_chest_pocket": {
          "$ref": "#/$defs/anchor_point"
        },
        "left_shoulder_seam": {
          "$ref": "#/$defs/anchor_point"
        },
        "right_shoulder_seam": {
          "$ref": "#/$defs/anchor_point"
        },
        "left_sleeve_upper": {
          "$ref": "#/$defs/anchor_point"
        },
        "right_sleeve_upper": {
          "$ref": "#/$defs/anchor_point"
        },
        "belt_center": {
          "$ref": "#/$defs/anchor_point"
        },
        "left_ankle": {
          "$ref": "#/$defs/anchor_point"
        },
        "right_ankle": {
          "$ref": "#/$defs/anchor_point"
        },
        "left_foot_top": {
          "$ref": "#/$defs/anchor_point"
        },
        "right_foot_top": {
          "$ref": "#/$defs/anchor_point"
        }
      }
    },
    "accessories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/accessory_instance"
      }
    }
  },
  "$defs": {
    "anchor_point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visible"
      ],
      "properties": {
        "x_px": {
          "type": "number"
        },
        "y_px": {
          "type": "number"
        },
        "visible": {
          "type": "boolean",
          "description": "False when the annotator could not see/click this anchor (out of frame, occluded)."
        }
      },
      "if": {
        "properties": {
          "visible": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "x_px",
          "y_px"
        ]
      }
    },
    "accessory_instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class_name",
        "present"
      ],
      "properties": {
        "class_name": {
          "enum": [
            "shirt",
            "trousers",
            "headwear",
            "cap_badge",
            "epaulette",
            "sleeve_rank",
            "arms_badge",
            "belt",
            "footwear"
          ]
        },
        "side": {
          "enum": [
            "left",
            "right",
            "center"
          ]
        },
        "present": {
          "type": "boolean"
        },
        "polygon_px": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          }
        }
      },
      "if": {
        "properties": {
          "present": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "polygon_px"
        ]
      }
    }
  }
}
